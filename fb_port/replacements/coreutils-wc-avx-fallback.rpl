convert c:
    extern struct wc_lines
    wc_lines_avx2 (int fd)
    {
      intmax_t lines = 0;
      intmax_t bytes = 0;
      __m256i endlines = _mm256_set1_epi8 ('\n');
      while (true)
        {
           __m256i avx_buf[IO_BUFSIZE / sizeof (__m256i)];
          ssize_t bytes_read = read (fd, avx_buf, sizeof avx_buf);
          if (bytes_read <= 0)
            return (struct wc_lines) { bytes_read == 0 ? 0 : (*__errno_location ()), lines, bytes };
          bytes += bytes_read;
          __m256i *datap = avx_buf;
          while (bytes_read >= 32)
            {
               __m256i to_match = _mm256_load_si256 (datap);
               __m256i matches = _mm256_cmpeq_epi8 (to_match, endlines);
               int mask = _mm256_movemask_epi8 (matches);
               lines += __builtin_popcount (mask);
               datap += 1;
               bytes_read -= 32;
            }
          char *end = (char *) datap + bytes_read;
          for (char *p = (char *) datap; p < end; p++)
            lines += *p == '\n';
        }
    }
to fb:
    Private Function wc_lines_avx2(ByVal fd As c2fb_c_int) As c2fb_wc_lines
        Dim lines As c2fb_int64 = 0
        Dim bytes As c2fb_int64 = 0
        Dim buffer(0 To c2fb_IO_BUFSIZE - 1) As UByte
        Dim bytesRead As c2fb_c_long
        Dim readError As c2fb_c_int = 0
        Dim byteIndex As Long
        While True
            bytesRead = c2fb_external_read(fd, @buffer(0), c2fb_IO_BUFSIZE)
            If bytesRead <= 0 Then
                If bytesRead < 0 Then
                    readError = *c2fb_external___errno_location()
                End If
                Return Type<c2fb_wc_lines>(readError, lines, bytes)
            End If
            bytes += bytesRead
            For byteIndex = 0 To bytesRead - 1
                If buffer(byteIndex) = 10 Then
                    lines += 1
                End If
            Next
        Wend
    End Function
